# Сгенерируй длинное случайное значение перед деплоем:
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

AI_SERVICE_ENABLED=true
SEED_TRACKS_DIR=/app/seed-content/tracks

# CPU-safe настройки AI для обычного VPS. Для более точного, но медленного анализа можно поставить small/medium.
MIYU_AI_LOG_LEVEL=INFO
MIYU_AI_WHISPER_MODEL=base
MIYU_AI_WHISPER_DEVICE=cpu
MIYU_AI_WHISPER_COMPUTE_TYPE=int8
MIYU_AI_WHISPER_NUM_WORKERS=1
# На CPU-only VPS отключаем тяжёлые текстовые модели, чтобы анализ не зависал на скачивании Detoxify/e5.
# Словарный explicit-анализ, аудио-признаки и Whisper остаются включёнными.
MIYU_AI_ENABLE_TOXICITY_MODEL=false
MIYU_AI_ENABLE_TEXT_EMBEDDINGS=false
HF_HUB_DISABLE_XET=1

# Email (SMTP Gmail)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=
